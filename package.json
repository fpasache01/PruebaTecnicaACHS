{
  "name": "prueba-tecnica-achs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "tsx src/api/migrate.ts",
    "db:setup": "npm run db:migrate && npm run seed:indicators && npm run seed:rdn",
    "extract:golden": "tsx scripts/extract_golden.ts",
    "calibrate:indicators": "tsx scripts/calibrate_indicators.ts",
    "build:rdn-seed": "tsx scripts/build_rdn_seed.ts",
    "seed:indicators": "tsx scripts/seed_indicators.ts",
    "seed:rdn": "tsx scripts/seed_rdn.ts",
    "run:golden": "tsx scripts/run_golden.ts",
    "dev": "tsx src/api/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
